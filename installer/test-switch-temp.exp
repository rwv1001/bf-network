#!/usr/bin/expect

set timeout 30

# Default values
set port         ""
set current_pass ""
set new_password ""
set mgmt_ip      ""
set uplink_nn    ""
set login_user   "admin"
set username     ""   
set name ""
set pubkey   ""  
set debug 0
set do_wipe 0

# Parse command line arguments
for {set i 0} {$i < $argc} {incr i} {
    set arg [lindex $argv $i]

    switch -- $arg {
        "-port" {
            incr i
            set port [lindex $argv $i]
        }
        "-login-user" {
            incr i
            set login_user [lindex $argv $i]
        }
        "-cp" {
            incr i
            set current_pass [lindex $argv $i]
        }
        "-np" {
            incr i
            set new_password [lindex $argv $i]
        }
        "-ip" {
            incr i
            set mgmt_ip [lindex $argv $i]
        }
        "-up" {
            incr i
            set uplink_nn [lindex $argv $i]
        }
        "-user" {
            incr i
            set username [lindex $argv $i]
        }
        "-name" {
            incr i
            set switch_name [lindex $argv $i]
        }
        "-pubkey" {
            incr i
            set pubkey [lindex $argv $i]
        }
        "-vlan-config" {
            incr i
            set vlan_config [lindex $argv $i]
        }        
        "-dynamic-config" {
            incr i
            set dynamic_config [lindex $argv $i]
        }
        "-debug" {
            set debug 1
        }
        "-wipe" {
            set do_wipe 1
        }
        default {
            puts "Unknown option: $arg"
            exit 1
        }
    }
}

# Validate required arguments
if {$port eq ""} {
    puts "Usage: $argv0 -port <serial_port> [-cp <current_password>] [-login-user <user>] [-user <newuser>] [-np <new_password>] [-ip <management_ip>] [-up <uplink_port>] [-debug]"
    exit 1
}

set change_password   [expr {$new_password ne ""}]
set set_ip            [expr {$mgmt_ip ne ""}]
set configure_uplink  [expr {$uplink_nn ne ""}]

set serial [open $port "r+"]

fconfigure $serial \
    -mode 9600,n,8,1 \
    -handshake none \
    -buffering none \
    -blocking 1 \
    -translation binary \
    -eofchar {}

spawn -open $serial
log_user 1




set timeout 180
set max_wake 12
set woke 0
sleep 1
send "\r"
sleep 1

for {set wake 1} {$wake <= $max_wake} {incr wake} {
    send "\r"
    expect {
        -re {Automatic configuration is running} {
            puts "Auto-config running — sending Ctrl-C"
            send "\x03"
            sleep 1
            send "\r"
            exp_continue
        }
        -re {[Ll]ogin:|[Uu]sername:} {
            set woke 1
            # stay in expect buffer state; handle login below
        }
        -re {[Pp]assword:} {
            set woke 2
        }
        -re {[<\[][^>\]]+[>\]]} {
            set woke 3
            puts "Already at CLI prompt."
        }
        -re {[Ll]ogin failed|[Aa]uthentication failed} {
            puts "Saw login-failed banner; waiting before next Enter..."
            sleep 2
            continue
        }
        timeout {
            puts "Wake attempt $wake/$max_wake: no prompt yet"
            continue
        }
    }
    if {$woke > 0} {
        break
    }
}

if {$woke == 0} {
    puts "ERROR: Did not see Login/Password/CLI prompt after $max_wake tries"
    exit 1
}
proc debug_pw {label pw} {
    set shown $pw
    if {$shown eq ""} {
        set shown "(empty)"
    }
    puts "DEBUG $label: len=[string length $pw] value=\[$shown\]"
}
# === LOGIN ===
set max_attempts 3
set attempt 1
while {$attempt <= $max_attempts} {
    if {$woke == 3} {
        # already logged in
        break
    }

    if {$woke == 1} {
        send "$login_user\r"
        expect {
            -re {[Pp]assword:} {}
            timeout {
                puts "ERROR: No Password prompt after username"
                exit 1
            }
        }
    }
    # woke == 2 → already at Password:

    if {$attempt == 1} {
        debug_pw "login attempt 1 using current_pass" $current_pass
        send "$current_pass\r"
    } else {
        flush stdout
        stty -echo
        expect_user -re "(.*)\n" {
            set current_pass $expect_out(1,string)
        }
        stty echo
        puts ""
        debug_pw "login retry using current_pass" $current_pass
        send "$current_pass\r"
    }

    expect {
        -re {AAA authentication failed\.|[Ii]ncorrect|[Ll]ogin failed} {
            puts "Incorrect password (attempt $attempt of $max_attempts)."
            if {$attempt == $max_attempts} {
                puts "ERROR: Too many failed login attempts."
                exit 2
            }
            incr attempt
            set woke 0
            sleep 1
            # re-sync to Login:
            for {set wake 1} {$wake <= 6} {incr wake} {
                send "\r"
                expect {
                    -re {[Ll]ogin:|[Uu]sername:} {
                        set woke 1
                        break
                    }
                    -re {[Pp]assword:} {
                        set woke 2
                        break
                    }
                    timeout continue
                }
            }
            if {$woke == 0} {
                puts "ERROR: Could not recover Login prompt after failed auth"
                exit 1
            }
            continue
        }
        -re {<[^>\r\n]+>%[^\r\n]*[\r\n]*} {
            puts "Login successful (prompt+log on same line)."
            break
        }
        timeout {
            puts "ERROR: Login timed out"
            puts "Last buffer: $expect_out(buffer)"
            exit 1
        }
    }
}

set timeout 30

send "undo terminal monitor\r"
expect { -re {%[^\r\n]*[\r\n]+} { exp_continue } -re {<[^>\r\n]+>} {} }

# === FACTORY RESET (optional) ===
if {$do_wipe} {
    puts "Wiping switch to factory defaults..."
    send "restore factory-default\r"
    expect {
        -re {\[Y/N\]:} {
            send "Y\r"
        }
        -re {[Cc]ontinue\?} {
            expect -re {\[Y/N\]:}
            send "Y\r"
        }
        timeout {
            puts "ERROR: No confirmation after restore factory-default"
            exit 1
        }
    }
    expect {
        -re {<[^>\r\n]+>} {}
        timeout {
            puts "WARNING: No user-view prompt after restore; continuing to reboot"
        }
    }

    send "reboot\r"
    expect {
        -re {save current configuration\?} {
            expect -re {\[Y/N\]:}
            send "N\r"
            exp_continue
        }
        -re {[Cc]urrent configuration may be lost} {
            expect -re {\[Y/N\]:}
            send "N\r"
            exp_continue
        }
        -re {This command will reboot} {
            expect -re {\[Y/N\]:}
            send "Y\r"
        }
        -re {Are you sure\?} {
            send "Y\r"
        }
        -re {Continue\?} {
            expect -re {\[Y/N\]:}
            send "Y\r"
        }
        timeout {
            puts "ERROR: Did not see reboot confirmation"
            exit 1
        }
    }

    puts "Waiting for factory-reset reboot (this may take 2–4 minutes)..."
    sleep 150
    set timeout 15

    set woke 0
    for {set wake 1} {$wake <= 24} {incr wake} {
        send "\r"
        expect {
            -re {Performing automatic configuration|Automatic configuration is running|CTRL_C or CTRL_D to break} {
                puts "Auto-config after wipe — sending Ctrl-C"
                send "\x03"
                sleep 1
                send "\r"
                exp_continue
            }
            -re {Press ENTER|Press Enter} {
                send "\r"
                exp_continue
            }
            -re {[Ll]ogin:|[Uu]sername:} {
                set woke 1
            }
            -re {[Pp]assword:} {
                set woke 2
            }
            -re {<[^>\r\n]+>} {
                set woke 3
            }
            timeout {
                puts "Wipe reboot wake $wake/24: no prompt yet"
            }
        }
        if {$woke > 0} {
            break
        }
    }
    if {$woke == 0} {
        puts "ERROR: Switch did not return to a prompt after factory reset"
        exit 1
    }

    set login_user "admin"
    set saved_pass $current_pass
    if {$saved_pass eq "" && $new_password ne ""} {
        set saved_pass $new_password
    }
    # Password we will set if factory-default (empty) login works
    set target_pass $current_pass
    if {$target_pass eq ""} {
        set target_pass $new_password
    }

    proc resync_login_prompt {} {
        upvar woke woke
        set woke 0
        for {set wake 1} {$wake <= 8} {incr wake} {
            send "\r"
            expect {
                -re {[Ll]ogin:|[Uu]sername:} { set woke 1; return }
                -re {[Pp]assword:}           { set woke 2; return }
                -re {<[^>\r\n]+>}            { set woke 3; return }
                timeout {}
            }
        }
    }

    proc apply_first_login {old_pass new_pass} {
        expect {
            -re {[Oo]ld password:} {}
            timeout {}
        }
        send "$old_pass\r"
        expect {
            -re {[Nn]ew password:} {}
            timeout {
                puts "ERROR: No New password prompt after factory reset"
                exit 1
            }
        }
        if {$new_pass eq ""} {
            puts "ERROR: Need -np (or a non-empty -cp) to set admin password after empty login"
            exit 1
        }
        send "$new_pass\r"
        expect {
            -re {[Cc]onfirm|[Nn]ew password:} {}
            timeout {
                puts "ERROR: No confirm-password prompt after factory reset"
                exit 1
            }
        }
        send "$new_pass\r"
        expect {
            -re {not meet|invalid|too simple|Password is absent|Please retry} {
                puts "ERROR: New admin password rejected by switch complexity policy"
                exit 1
            }
            -re {<[^>\r\n]+>} {}
            timeout {
                puts "ERROR: Login timed out after first-login password change"
                exit 1
            }
        }
    }

    if {$woke != 3} {
        set logged_in 0
        set used_empty 0
        set max_try 4
        for {set try 1} {$try <= $max_try} {incr try} {
            if {$try % 2 == 1} {
                set try_pass ""
                puts "Post-wipe login try $try/$max_try: empty password"
            } else {
                set try_pass $saved_pass
                puts "Post-wipe login try $try/$max_try: saved/current password"
            }

            if {$woke == 1} {
                send "$login_user\r"
                expect {
                    -re {[Pp]assword:} {}
                    timeout {
                        puts "ERROR: No Password prompt after factory reset"
                        exit 1
                    }
                }
            }

            send "$try_pass\r"

            expect {
                -re {AAA authentication failed\.|[Ii]ncorrect|[Ll]ogin failed} {
                    puts "Post-wipe login failed with this password"
                    resync_login_prompt
                    continue
                }
                -re {First login|password reset|Old password:} {
                    puts "First-login password change required after factory reset"
                    apply_first_login $try_pass $target_pass
                    set current_pass $target_pass
                    set new_password $target_pass
                    set change_password 1
                    set used_empty [expr {$try_pass eq ""}]
                    set logged_in 1
                }
                -re {<[^>\r\n]+>} {
                    set current_pass $try_pass
                    set used_empty [expr {$try_pass eq ""}]
                    set logged_in 1
                }
                timeout {
                    puts "Post-wipe login timed out; trying next password"
                    resync_login_prompt
                    continue
                }
            }
            if {$logged_in} {
                break
            }
        }

        if {!$logged_in} {
            puts "ERROR: Login failed after factory reset (tried empty and current passwords)"
            exit 2
        }

        # Empty password worked and first-login did not already set one
        if {$used_empty && $current_pass eq "" && $target_pass ne ""} {
            puts "Empty factory login succeeded — setting admin password"
            send "system-view\r"
            expect {
                -re {\[[^\]]+\]} {}
                timeout {
                    puts "ERROR: no system-view after empty login"
                    exit 1
                }
            }
            send "local-user admin\r"
            expect -re {\[[^\]]+\]}
            send "password simple $target_pass\r"
            expect {
                -re {[Oo]ld password:} {
                    send "\r"
                    expect -re {\[[^\]]+\]}
                }
                -re {\[[^\]]+\]} {}
            }
            send "authorization-attribute user-role network-admin\r"
            expect -re {\[[^\]]+\]}
            send "service-type ssh https terminal\r"
            expect -re {\[[^\]]+\]}
            send "quit\r"
            expect -re {\[[^\]]+\]}
            send "quit\r"
            expect -re {<[^>\r\n]+>}
            set current_pass $target_pass
            set new_password $target_pass
            set change_password 1
        }
    }

    send "undo terminal monitor\r"
    expect { -re {%[^\r\n]*[\r\n]+} { exp_continue } -re {<[^>\r\n]+>} {} }
    puts "Factory reset complete; applying new configuration."
    set timeout 30
}

send "system-view\r"


# === ENTER SYSTEM VIEW ===

expect {
    -re {\[[^\]]+\]} { }
    timeout {
        puts "ERROR: no system-view prompt"
        exit 1
    }
}

# === SET SWITCH NAME ===
if {[info exists switch_name] && $switch_name ne ""} {
    expect "]"
    send "sysname $switch_name\r"
    expect "]"
    puts "Switch name set to: $switch_name"
}

# === CHANGE PASSWORD (only if -np was provided) ===
if {$change_password} {

    expect "]"
    send "local-user admin\r"

    expect "]"
    send "password simple $new_password\r"

    expect {
        "Old password:" {
            send "$current_pass\r"
        }
        "]" {
            # Some versions don't ask for old password
        }
    }

    expect "]"
    send "authorization-attribute user-role network-admin\r"

    expect "]"
    send "service-type ssh https terminal\r"

    expect "]"
    send "quit\r"
    set current_pass $new_password
}

# === ENABLE PASSWORD RECOVERY ===
expect "]"
send "password-recovery enable\r"



expect "]"
send "display irf\r"

expect {
    -re {\*\+([0-9]).*} {
        set member_id $expect_out(1,string)
        puts "Current IRF MemberID: $member_id\r"

        if {$member_id != 1} {
            puts "MemberID is $member_id. Renumbering to 1..."
            expect "]"
            send "irf member $member_id renumber 1\r"

            expect {
                -re {Continue\?\s*\[Y/N\]:} {
                    send "Y\r"
                }
                timeout {
                    puts "ERROR: Did not see IRF renumber confirmation prompt"
                    exit 1
                }
            }

            expect {
                -re {\r?\n\[[^\r\n\]]+\]} {}
                timeout {
                    puts "ERROR: Did not return to system-view prompt after IRF renumber"
                    exit 1
                }
            }

            send "save force\r"           

            puts "Rebooting switch to apply new MemberID..."
            expect "]"
            send "quit\r"
            expect "<"
            send "reboot\r"
            expect {Are you sure?}
            send "Y\r"

            # Wait for switch to reboot and come back to login prompt
            puts "Waiting for switch to reboot (this may take 60-120 seconds)..."
            set timeout 420
            sleep 180
            send "\r\r"
            sleep 2
            send "\r\r"
            expect {
                -re {Automatic configuration is running} {
                    puts "Auto-config after reboot — sending Ctrl-C"
                    send "\x03"
                    sleep 1
                    send "\r"
                    exp_continue
                }
                "Login:" {
                    puts "Switch is back online. Re-logging in..."
                    send "$login_user\r"
                }
                timeout {
                    puts "ERROR: Switch did not come back after reboot"
                    exit 1
                }
            }

            expect "Password:"
            if {$new_password ne ""} {
                send "$new_password\r"
            } elseif {$current_pass ne ""} {
                send "$current_pass\r"
            } else {
                send "\r"
            }

            expect "<"
            send "system-view\r"
        } else {
            puts "MemberID is already 1. No renumbering needed."
        }
    }
    timeout {
        puts "WARNING: Could not determine IRF MemberID. Continuing anyway..."
    }
}

# Reset timeout to normal
set timeout 25

# === CONFIGURE VLAN 1 + UPLINK ===
if {$configure_uplink} {

    expect "]"
    send "vlan 1\r"

    expect "]"
    send "name UDM\r"

    expect "]"
    send "description UPLINK-TO-UDM\r"

    expect "]"
    send "dhcp snooping binding record\r"

    expect "]"
    send "quit\r"

    expect "]"
    send "interface GigabitEthernet1/0/$uplink_nn\r"

    expect "]"
    send "description UPLINK\r"

    expect "]"
    send "port link-type trunk\r"

    expect "]"
    send "port trunk permit vlan 1\r"

    expect "]"
    send "dhcp snooping trust\r"

    expect "]"
    send "quit\r"
}

# === SET MANAGEMENT IP ===
if {$set_ip} {

    expect "]"
    send "interface Vlan-interface 1\r"

    expect "]"
    send "description UPLINK\r"

    expect "]"
    send "ip address $mgmt_ip 255.255.255.0\r"

    expect "]"
    send "quit\r"
}
if {[info exists vlan_config] && $vlan_config ne ""} {
    send "$vlan_config\r"
}

if {[info exists dynamic_config] && $dynamic_config ne ""} {
    send "$dynamic_config\r"
}

if {$username ne "" && $pubkey ne ""} {

    expect "]"
    send "local-user $username class manage\r"

    expect "]"
    send "service-type ssh\r"

    expect "]"
    send "authorization-attribute user-role network-admin\r"

    expect "]"
    send "quit\r"

    # Create public key
    expect "]"
    send "public-key peer ${username}_KEY\r"

    expect "]"
    send "public-key-code begin\r"

    send "$pubkey\r"

    expect "]"
    send "public-key-code end\r"

    expect "]"
    send "peer-public-key end\r"

    # Assign public key to the user
    expect "]"
    send "ssh user $username service-type stelnet authentication-type publickey assign publickey ${username}_KEY\r"

    

    # Enable SSH server
    expect "]"
    send "ssh server enable\r"

    # Configure domain for local authentication
    expect "]"
    send "domain system\r"
    expect "]"
    send "authentication login local\r"
    expect "]"
    send "authorization login local\r"
    expect "]"
    send "quit\r"

    # Properly configure vty lines for SSH
    expect "]"
    send "line vty 0 4\r"
    expect "]"
    send "authentication-mode scheme\r"
    expect "]"
    send "user-role network-admin\r"
    expect "]"
    send "user-role network-operator\r"
    expect "]"
    send "protocol inbound ssh\r"
    expect "]"
    send "idle-timeout 15 0\r"
    expect "]"
    send "quit\r"

    expect "]"
    send "line vty 5 63\r"
    expect "]"
    send "authentication-mode scheme\r"
    expect "]"
    send "user-role network-admin\r"
    expect "]"
    send "quit\r"
}

# Get and display the MAC address of the management interface
expect "]"
send "display interface Vlan-interface 1\r"

expect {
    -re {hardware address: ([0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4})} {
        set mac_address $expect_out(1,string)
        puts "\n=== Switch MAC Address ==="
        puts "Management IP : $mgmt_ip"
        puts "MAC Address   : $mac_address"
        puts "==========================\n"
    }
    timeout {
        puts "WARNING: Could not extract MAC address"
    }
}
# === SAVE CONFIGURATION ===
expect "]"
send "save force\r"




# === CLEAN EXIT ===
expect "]"
send "quit\r"

# === DEBUG: Show current configuration ===
if {$debug} {
    expect "<"
    send "screen-length disable\r"
    expect "<"
    send "undo terminal monitor\r"
    expect "<"    
    send "display current-configuration\r"
    
    # Wait for the end of the configuration output
    expect {
        "<" {
            # End of configuration output
        }
        timeout {
            puts "Debug output may be truncated"
        }
    }
}

expect "<"
send "quit\r"

expect eof
