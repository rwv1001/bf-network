# FreeRADIUS clients configuration
# Switch client stanzas are generated dynamically from SWITCH_HOSTS by entrypoint.sh
# — do not add per-switch entries here.
#
# BlastRADIUS (CVE-2024-3596): every client that is able to send
# Message-Authenticator in Access-Request must be required to do so.
# Only the HP5130 stanzas (generated by entrypoint.sh) relax this, because
# Comware MAC-authentication requests carry no Message-Authenticator.

# Captive Portal - CoA requests
client captive-portal {
        ipaddr = ${PORTAL_IP}
        secret = ${RADIUS_SECRET}
        shortname = portal
        require_message_authenticator = yes
        limit_proxy_state = yes

        # This client can send CoA/Disconnect requests
        # Note: The CoA server is configured in sites-available/coa
}

# Localhost for testing
client localhost {
        ipaddr = 127.0.0.1
        secret = ${RADIUS_SECRET}
        shortname = localhost
        require_message_authenticator = yes
        limit_proxy_state = yes
}

