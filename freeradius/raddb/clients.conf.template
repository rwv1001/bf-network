# FreeRADIUS clients configuration
# This template file uses environment variables

# HP 5130 switch 1 - MAC authentication
client hp5130-switch {
        ipaddr = ${SWITCH_HOST}
        secret = ${RADIUS_SECRET}
        shortname = hp5130-sw1
        nas_type = other
        require_message_authenticator = false
        limit_proxy_state = true
}

# HP 5130 switch 2 - MAC authentication
client hp5130-switch-2 {
        ipaddr = ${SW2_IP}
        secret = ${RADIUS_SECRET}
        shortname = hp5130-sw2
	nas_type = other
	require_message_authenticator = false
	limit_proxy_state = true
}

# Captive Portal - CoA requests
client captive-portal {
	ipaddr = ${PORTAL_IP}
	secret = ${RADIUS_SECRET}
	shortname = portal
	
	# This client can send CoA/Disconnect requests
	# Note: The CoA server is configured in sites-available/coa
}

# Localhost for testing
client localhost {
	ipaddr = 127.0.0.1
	secret = ${RADIUS_SECRET}
	shortname = localhost
}
