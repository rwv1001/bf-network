# ./raddb/proxy.d/hp5130_coa.conf

home_server hp5130_coa {
  type   = coa
  ipaddr = 192.168.99.2     # HP 5130 SVI (the NAS-IP you target)
  port   = 3799
  secret = ${RADIUS_SECRET} # must match the switch's "radius dynamic-author ... key"
}

# Optional pool (handy if you later add more NASes)
home_server_pool hp5130_coa_pool {
  home_server = hp5130_coa
}

# Realm used to proxy incoming CoA/Disconnect requests to the switch
realm hp5130 {
  type = radius
  coa_pool = hp5130_coa_pool
}
