{
  "Dhcp4": {
    "authoritative": true,
    "interfaces-config": {
      "interfaces": [ "eth0.10", "eth0.20", "eth0.30", "eth0.40", "eth0.50", "eth0.60", "eth0.99" ],
      "dhcp-socket-type": "raw"
    },

    "multi-threading": {
      "enable-multi-threading": true
    },
    
    "control-socket": {
      "socket-type": "unix",
      "socket-name": "/kea/sockets/kea4-ctrl-socket"
    },
    
    "hooks-libraries": [
      {
        "library": "/usr/local/lib/kea/hooks/libdhcp_pgsql.so"
      },
      {
        "library": "/usr/local/lib/kea/hooks/libdhcp_host_cmds.so"
      },
      {
        "library": "/usr/local/lib/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/local/lib/kea/hooks/dhcp_dns_hijack.so"
      }
    ],
    
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/kea/leases/kea-leases4.csv",
      "lfc-interval": 3600
    },
    
    "hosts-database": {
      "type": "postgresql",
      "name": "captive_portal",
      "user": "portal_user",
      "password": "change_this_password",
      "host": "127.0.0.1",
      "port": 5432
    },
    
    "expired-leases-processing": {
      "reclaim-timer-wait-time": 10,
      "flush-reclaimed-timer-wait-time": 25,
      "hold-reclaimed-time": 3600,
      "max-reclaim-leases": 100,
      "max-reclaim-time": 250,
      "unwarned-reclaim-cycles": 5
    },
    
    "renew-timer": 900,
    "rebind-timer": 1800,
    "valid-lifetime": 86400,
    
    "option-data": [
      {
        "name": "domain-name",
        "data": "blackfriars.local"
      },
      {
        "name": "domain-name-servers",
        "data": "192.168.99.4"
      }
    ],

    "client-classes": [
      {
        "name": "BLOCKED",
        "test": "0 == 1"
      }
    ],
    
    "subnet4": [
      {
        "subnet": "192.168.10.0/24",
        "id": 10,
        "pools": [
          {
            "pool": "192.168.10.5 - 192.168.10.213"
          },
          {
            "pool": "192.168.10.214 - 192.168.10.254",
            "client-class": "BLOCKED"
          }
        ],
        "interface": "eth0.10",
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.10.1"
          }
        ],
        "reservations": []
      },
      {
        "subnet": "192.168.20.0/24",
        "id": 20,
        "pools": [
          {
            "pool": "192.168.20.5 - 192.168.20.213"
          },
          {
            "pool": "192.168.20.214 - 192.168.20.254",
            "client-class": "BLOCKED"
          }
        ],
        "interface": "eth0.20",
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.20.1"
          }
        ],
        "reservations": []
      },
      {
        "subnet": "192.168.30.0/24",
        "id": 30,
        "pools": [
          {
            "pool": "192.168.30.5 - 192.168.30.213"
          },
          {
            "pool": "192.168.30.214 - 192.168.30.254",
            "client-class": "BLOCKED"
          }
        ],
        "interface": "eth0.30",
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.30.1"
          }
        ],
        "reservations": []
      },
      {
        "subnet": "192.168.40.0/24",
        "id": 40,
        "pools": [
          {
            "pool": "192.168.40.5 - 192.168.40.213"
          },
          {
            "pool": "192.168.40.214 - 192.168.40.254",
            "client-class": "BLOCKED"
          }
        ],
        "interface": "eth0.40",
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.40.1"
          }
        ],
        "reservations": []
      },
      {
        "subnet": "192.168.50.0/24",
        "id": 50,
        "pools": [
          {
            "pool": "192.168.50.5 - 192.168.50.213"
          },
          {
            "pool": "192.168.50.214 - 192.168.50.254",
            "client-class": "BLOCKED"
          }
        ],
        "interface": "eth0.50",
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.50.1"
          }
        ],
        "reservations": []
      },
      {
        "subnet": "192.168.60.0/24",
        "id": 60,
        "pools": [
          {
            "pool": "192.168.60.5 - 192.168.60.213"
          },
          {
            "pool": "192.168.60.214 - 192.168.60.254",
            "client-class": "BLOCKED"
          }
        ],
        "interface": "eth0.60",
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.60.1"
          }
        ],
        "reservations": []
      },

      {
        "subnet": "192.168.99.0/24",
        "id": 99,
        "pools": [
          {
            "pool": "192.168.99.100 - 192.168.99.254"
          }
        ],
        "interface": "eth0.99",
        "option-data": [
          {
            "name": "routers",
            "data": "192.168.99.1"
          },
          {
            "name": "domain-name-servers",
            "data": "8.8.8.8, 8.8.4.4"
          }
        ],
        "reservations": []
      }
    ],
    
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output_options": [
          {
            "output": "stdout",
            "pattern": "%-5p %m\n"
          }
        ],
        "severity": "INFO",
        "debuglevel": 0
      }
    ]
  }
}
