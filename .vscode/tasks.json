{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Launch Aider (Claude 4.6 Sonnet)",
      "type": "shell",
      "command": "aider",
      "args": [
        "--model",
        "claude-sonnet-4-6",
        "--no-show-model-warnings"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEEPSEEK_API_KEY": "${env:DEEPSEEK_API_KEY}",
          "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}